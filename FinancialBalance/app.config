<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
    </configSections>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <appSettings>
        <!-- OAuth client of type "Desktop app" from the Google Cloud console.
             Left empty, the Generate to Google Drive button says what to do and
             does nothing else. The secret is not confidential for an installed
             application - the flow is protected by PKCE, not by hiding this -
             but it is still a credential sitting in a plain text file, exactly
             like the database password above it. -->
        <add key="GoogleClientId" value="" />
        <add key="GoogleClientSecret" value="" />
        <!-- What the Sheet in Google Drive is called. The same file is reused every
             time, so the link keeps working. Empty falls back to
             "Financial Balance ETFs or Stocks Investments". -->
        <add key="GoogleSheetName" value="" />
    </appSettings>
    <connectionStrings>
        <add name="FinancialBalance.Properties.Settings.Financial_BalanceConnectionString"
            connectionString="Provider=Microsoft.Jet.OLEDB.4.0;Data Source=&quot;|DataDirectory|\database\Financial Balance.mdb&quot;;Persist Security Info=True;Jet OLEDB:Database Password=01121980"
            providerName="System.Data.OleDb" />
        <add name="FinancialBalance.Properties.Settings.Financial_BalanceConnectionString1"
            connectionString="Provider=Microsoft.Jet.OLEDB.4.0;Data Source=&quot;|DataDirectory|\Financial Balance.mdb&quot;;Persist Security Info=True;Jet OLEDB:Database Password=01121980"
            providerName="System.Data.OleDb" />
    </connectionStrings>
</configuration>