<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
    </configSections>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <appSettings>
        <!-- OAuth client of type "Desktop app" from the Google Cloud console.
             Left empty, the Generate to Google Drive button says what to do and
             does nothing else. The secret is not confidential for an installed
             application - the flow is protected by PKCE, not by hiding this -
             but it is still a credential sitting in a plain text file, exactly
             like the database password above it. -->
        <add key="GoogleClientId" value="" />
        <add key="GoogleClientSecret" value="" />
        <!-- What the Sheet in Google Drive is called. The same file is reused every
             time, so the link keeps working. Empty falls back to
             "Financial Balance ETFs or Stocks Portfolio Investments". -->
        <add key="PortfolioGoogleSheetName" value="" />
        <!-- The Sheet the ETF/Stock Dividend History page writes to. A different file
             from the portfolio one, since the two are different shapes. Empty falls
             back to "Financial Balance ETFs or Stocks Dividend History". -->
        <add key="DividendHistoryGoogleSheetName" value="" />
        <!-- The Sheet the ETF/Stock Financial Year Historical page writes to, without
             the year : the financial year on screen is added to the end of it, so each
             year keeps a Sheet of its own. Empty falls back to "Financial Balance ETFs
             or Stocks Financial Year Historical". -->
        <add key="FinancialHistoricalYearPrefixGoogleSheetName" value="" />
        <!-- The Sheet the ETF/Stock Forecast Dividend Calendar page writes to. One
             file, reused : the forecast is of the portfolio as it stands, so each run
             replaces the last. Empty falls back to "Financial Balance ETFs or Stocks
             Forecast Dividend Calendar". -->
        <add key="ForecastDividendCalendarGoogleSheetName" value="" />
        <!-- The Sheet the Yearly Summary page writes to. One file for the lot : that
             page sends every year at once, a tab each. Empty falls back to
             "Financial Balance Yearly Summary". -->
        <add key="YearlySummaryGoogleSheetName" value="" />
    </appSettings>
    <connectionStrings>
        <add name="FinancialBalance.Properties.Settings.Financial_BalanceConnectionString"
            connectionString="Provider=Microsoft.Jet.OLEDB.4.0;Data Source=&quot;|DataDirectory|\database\Financial Balance.mdb&quot;;Persist Security Info=True;Jet OLEDB:Database Password=01121980"
            providerName="System.Data.OleDb" />
        <add name="FinancialBalance.Properties.Settings.Financial_BalanceConnectionString1"
            connectionString="Provider=Microsoft.Jet.OLEDB.4.0;Data Source=&quot;|DataDirectory|\Financial Balance.mdb&quot;;Persist Security Info=True;Jet OLEDB:Database Password=01121980"
            providerName="System.Data.OleDb" />
    </connectionStrings>
</configuration>